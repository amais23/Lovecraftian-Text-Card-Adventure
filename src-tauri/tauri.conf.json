{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LovecraftianCardAdventure",
  "version": "0.4.1",
  "identifier": "com.lovecraftian.cardadventure",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "克蘇魯文字卡牌冒險 · Lovecraftian Text-Card Adventure",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/amais23/Lovecraftian-Text-Card-Adventure/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXkKUldUUWJ6eU53MVRwRjM5Y1F0aUFLVldNTHB4V25MZXBhQmdJMWlyU1p2Q0UvR3ZtcXNqRk1rYjcK"
    }
  }
}
